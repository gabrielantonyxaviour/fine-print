+import type { Settings } from '../settings.ts';
+import { sha256Hex } from '../lib/hash.ts';
+
+// Conversion pixel for the growth team's signup campaign.
+export async function trackSignupConversion(settings: Settings, email: string): Promise<void> {
+  const params = new URLSearchParams({
+    id: settings.meta.pixelId,
+    ev: 'CompleteRegistration',
+    em: sha256Hex(email.trim().toLowerCase()),
+  });
+  await fetch(`https://graph.facebook.com/tr?${params.toString()}`, { method: 'POST' });
+}
